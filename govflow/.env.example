GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
FIRESTORE_DATABASE=
PUBSUB_TOPIC=
EVENT_BUS_MODE=local
PERSISTENCE_MODE=local
PORT=8000

# Part 2: agent layer config
STATUS_POLL_INTERVAL_SECONDS=2
STATUS_MAX_POLLS=10
MAX_TOOL_CALLS_PER_MINUTE=30

# Part 3: API config
# Rate limit on POST /api/workflows and POST /api/demo/run, per client IP.
API_RATE_LIMIT_PER_MINUTE=10
# API key auth on write routes -- disabled by default so local dev/demo is
# never blocked. Set API_KEY_REQUIRED=true and API_KEY=<some-secret> to
# require an X-API-Key header matching it.
API_KEY_REQUIRED=false
API_KEY=
